// Schéma Prisma — EnMoi
//
// Commandes utiles :
//   npx prisma studio                              inspecter la base
//   npx prisma generate                            régénérer le client
//   npx prisma migrate dev --name <description>    migration en dev (.env)
//   npm run migrate:postgres                       applique les migrations en prod (.env.production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

// ---------------------------------------------------------------------------
// Métier EnMoi
// ---------------------------------------------------------------------------

/// Une des 100 Forces (anciennement « aptitude »).
/// Le contenu rédactionnel n'est plus en base : le client fournit 2 pages PNG
/// (A et B) par force, déposées via le back-office et stockées sur S3.
/// Les clés sont nullable — une force peut exister avant que ses visuels
/// n'aient été déposés.
model Force {
  id       String  @id @default(cuid())
  number   Int     @unique /// 0 à 99, sert à choisir le bon visuel
  title    String
  pageAKey String? /// clé S3 de la page A
  pageBKey String? /// clé S3 de la page B

  /// Noms d'origine des fichiers déposés, conservés pour l'affichage uniquement.
  /// Ne jamais s'en servir pour construire une clé de stockage.
  pageAFilename String?
  pageBFilename String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("force")
}

/// Les 7 formules mathématiques qui transforment une date de naissance
/// en 7 numéros de force. Éditables depuis /admin/formules.
/// Un jeu complet des 7 formules, appliqué à une tranche d'années de naissance.
///
/// Le jeu **par défaut** porte `yearFrom` et `yearTo` à null : il s'applique à
/// toutes les dates qu'aucune tranche ne couvre. Il en existe exactement un.
///
/// Les autres jeux couvrent une tranche bornée, incluse de part et d'autre —
/// le premier cas est 2000-2009, où les formules du client diffèrent. Les
/// tranches ne doivent pas se chevaucher : la contrainte n'est pas exprimable
/// en SQL, elle est vérifiée à l'écriture (voir app/api/formulaSets).
model FormulaSet {
  id         String         @id @default(cuid())
  label      String
  yearFrom   Int?
  yearTo     Int?
  functions  MathFunction[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("formula_set")
}

model MathFunction {
  id         String     @id @default(cuid())
  setId      String
  set        FormulaSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  number     Int        /// position 1 à 7
  expression String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  /// Une seule expression par position dans un jeu donné.
  @@unique([setId, number])
  @@map("math_function")
}

model GlobalSettings {
  id                 String   @id @default(cuid())
  ambassadorAccounts Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@map("global_settings")
}

/// Profil pour lequel un PMI est généré.
/// Les champs paiement / ambassadeur / quiz relèvent de la phase « espace
/// utilisateur », pas encore branchée — ne pas s'appuyer dessus côté back-office.
model BirthProfile {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  birthDate  DateTime
  birthPlace String?
  gender     String?

  pdfLink      String? /// renseigné une fois le PMI généré
  shortComment String?
  longComment  String?

  isAmbassador Boolean @default(false)
  paymentPlan  Int     @default(0) /// 0 = non payé, 1/2/3 = formule choisie
  quizAnswer   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("birth_profile")
}

// ---------------------------------------------------------------------------
// better-auth — ne pas renommer les tables, l'adaptateur en dépend
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  firstName     String?
  lastName      String?
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  country       String?
  city          String?
  birthDate     DateTime?
  gender        String?
  isAmbassador  Boolean   @default(false)
  tokenBalance  Int       @default(0)
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  sessions      Session[]
  accounts      Account[]
  birthProfiles BirthProfile[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}
